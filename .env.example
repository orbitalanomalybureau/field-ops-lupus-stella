# Copy to .env.local for development. Nothing here is required to run the game
# locally — every value has a working default.

# Origins allowed to embed the game and exchange postMessage traffic with it.
# Comma-separated. The game's own origin is always allowed. Dev builds allow all.
VITE_EMBED_PARENT_ORIGINS=https://exodus2121.com,https://www.exodus2121.com

# Where the novel lives. Used for codex "Continue in 2121: EXODUS" links.
VITE_NOVEL_SITE_URL=https://exodus2121.com

# Optional: WebRTC ICE servers for reader-ghost presence. Comma-separated.
# Defaults to public Google + Cloudflare STUN. No TURN is configured — presence
# degrades gracefully to solo play behind symmetric NAT.
# VITE_STUN_URLS=stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478

# Optional: enables the presence signaling relay and telemetry endpoints.
# Without it both fall back to an in-memory store (fine for a single long-lived
# server, useless on serverless — see docs/DEPLOY notes).
# DATABASE_URL=postgres://user:pass@host/db
