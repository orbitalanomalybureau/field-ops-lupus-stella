{
  "name": "field-ops-lupus-stella",
  "version": "0.2.0",
  "private": true,
  "description": "Open-world Classified Terminal survey for 2121: EXODUS — the playable ground recon companion to the novel.",
  "license": "SEE LICENSE IN LICENSE",
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 8080",
    "build": "vite build",
    "db:migrate": "node scripts/migrate.mjs",
    "build:dev": "vite build --mode development",
    "build:preview": "FIELDOPS_NO_NITRO=1 vite build",
    "preview": "vite preview --host 0.0.0.0 --port 8080",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "playwright test",
    "test:update-goldens": "playwright test --update-snapshots",
    "budget": "node scripts/check-bundle-budget.mjs",
    "canon:lint": "node scripts/canon-lint.mjs",
    "verify": "npm run typecheck && npm run lint && npm run build && npm run budget"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.3",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@tailwindcss/vite": "^4.1.0",
    "@tanstack/react-router": "^1.160.0",
    "@tanstack/react-start": "^1.160.0",
    "@tanstack/router-plugin": "^1.160.0",
    "@types/three": "^0.185.1",
    "lucide-react": "^0.510.0",
    "pg": "^8.16.3",
    "postprocessing": "^6.39.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "three": "^0.185.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.16.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "lightningcss": "^1.28.0",
    "nitro": "3.0.260603-beta",
    "pixelmatch": "^6.0.0",
    "pngjs": "^7.0.0",
    "playwright": "^1.52.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.1.0"
  }
}
